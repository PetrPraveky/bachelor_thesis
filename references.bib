@inproceedings{bk_procedural_content_generation,
	title = {Procedural {Content} {Generation} with {Large} {Language} {Models} for {Three}-{Dimensional} {Environment} {Design}},
	issn = {2640-0227},
	url = {https://ieeexplore.ieee.org/document/11351639},
	doi = {10.1109/ICoDSE68111.2025.11351639},
	abstract = {The creation of three-dimensional (3D) game environments is a costly and time-consuming process, with major AAA titles often requiring 5-9 years of development and budgets ranging from 50–85 million. While Procedural Content Generation (PCG) can alleviate this burden, conventional tools still demand significant technical skill. This paper introduces a novel PCG plugin for Unreal Engine that leverages Large Language Models (LLMs) to generate complex 3D environments directly from natural language commands. To ensure consistent and reliable LLM outputs without resource-intensive fine-tuning, our system employs a suite of optimization techniques, including few-shot prompting, prompt engineering, Retrieval-Augmented Generation (RAG), and a strictly enforced JSON output schema. The system utilizes a two-layer architecture: an LLM Processing Layer interprets user intent and validates inputs, while a Content Generation Layer constructs the visual assets. A Python backend serves as the bridge between the plugin and the LLM. In an evaluation with 22 respondents, the RAG-enhanced system was preferred by {\textbackslash}mathbf7 4. 2 {\textbackslash}boldsymbol\% of users over a non-RAG baseline. The system achieved high average ratings (on a 1-5 scale) for visual quality (4.82), time efficiency (4.98), and prompt adherence (4.76). Furthermore, the structured output schema achieved a 100 \% success rate across all content categories, and our system prompt increased input-validation accuracy to 97\%. User evaluations confirm the system's effectiveness, awarding the plugin a perfect ease-of-use score (5.0/5.0) and a high overall satisfaction rating of 4.76/5.0. These results demonstrate that integrating PCG with LLMs is an effective approach to improving efficiency and usability in 3D environment design.},
	urldate = {2026-05-10},
	booktitle = {2025 {IEEE} {International} {Conference} on {Data} and {Software} {Engineering} ({ICoDSE})},
	author = {B, Hidayatullah Wildan Ghaly and Dewandaru, Agung and Wicaksono, Teguh Budi},
	month = oct,
	year = {2025},
	note = {ISSN: 2640-0227},
	keywords = {3D environment development, Accuracy, Engines, Large language models, Large Language Models, LLM optimization, Optimization, Procedural Content Generation, Procedural generation, Robustness, Software engineering, structured output, Three-dimensional displays, Unreal Engine, Usability, Visualization},
	pages = {413--418},
	file = {Full Text PDF:C\:\\Users\\nikdo\\Zotero\\storage\\U8RKJ39F\\B et al. - 2025 - Procedural Content Generation with Large Language Models for Three-Dimensional Environment Design.pdf:application/pdf},
}

@inproceedings{bk_controllable_procedural_generation,
	address = {New York, NY, USA},
	series = {{MM} '24},
	title = {Controllable {Procedural} {Generation} of {Landscapes}},
	isbn = {979-8-4007-0686-8},
	url = {https://dl.acm.org/doi/10.1145/3664647.3681129},
	doi = {10.1145/3664647.3681129},
	abstract = {Landscapes, recognized for their indispensable role in large-scale scenes, are experiencing growing demand. However, the manual modeling of such content is labor-intensive and lacks efficiency. Procedural Content Generation (PCG) techniques enable the rapid generation of diverse landscape elements. Nevertheless, ordinary users may encounter difficulties controlling these methods for desired results. In this paper, we introduce a controllable framework for procedurally generating landscapes. We integrate state-of-the-art Large Language Models (LLMs) to enhance user accessibility and control. By converting plain text inputs into parameters through LLMs, our framework allows ordinary users to generate a batch of plausible landscapes tailored to their specifications. A parameter-controlled PCG procedure is designed to leverage optimization techniques and employ rule-based refinements. It achieves harmonious layering in terrains, zoning, and roads while enabling aesthetic arrangement of vegetation and artificial elements. Extensive experiments demonstrate our framework's effectiveness in generating landscapes comparable to those crafted by experienced architects. Our framework has the potential to enhance the productivity of landscape designers significantly.},
	urldate = {2026-05-10},
	booktitle = {Proceedings of the 32nd {ACM} {International} {Conference} on {Multimedia}},
	publisher = {Association for Computing Machinery},
	author = {Liu, Jia-Hong and Zhang, Shao-Kui and Zhang, Chuyue and Zhang, Song-Hai},
	month = oct,
	year = {2024},
	pages = {6394--6403},
	file = {Full Text PDF:C\:\\Users\\nikdo\\Zotero\\storage\\LQ8VANHQ\\Liu et al. - 2024 - Controllable Procedural Generation of Landscapes.pdf:application/pdf},
}

